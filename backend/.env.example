# =======================================================
# CORE Hardware - Configurações de Ambiente do Backend
# =======================================================

# Chave da API do Google Gemini (obtenha em https://aistudio.google.com/)
# Nota: Se deixada vazia ou ausente, o sistema ativa automaticamente o Fallback Inteligente determinístico.
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo Gemini (padrão recomendado: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
