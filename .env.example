# =======================================================
# CORE Hardware - Configurações de Ambiente
# =======================================================

# Provedor de IA principal: 'grok', 'gemini' ou 'auto' (padrão: auto)
LLM_PROVIDER=auto

# Chave da API Grok (xAI) - Obtenha em https://console.x.ai/
XAI_API_KEY=sua_chave_grok_aqui
GROK_MODEL=grok-2-latest

# Chave da API Google Gemini (Alternativa gratuita) - Obtenha em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# Nota de Resiliência:
# Se nenhuma chave for fornecida ou se a API externa falhar, o sistema ativa
# automaticamente o Fallback Inteligente determinístico com telemetria local.
